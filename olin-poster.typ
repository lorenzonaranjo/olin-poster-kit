// olin-poster.typ: WashU Olin poster layout, 48 x 36 in landscape.
// Students do not edit this file. All content goes in main.typ.

#let olin-red = rgb("#BA0C2F")
#let olin-green = rgb("#215732")
#let ink = rgb("#1A1A1A")
#let muted = rgb("#5A5A5A")
#let tint = rgb("#F6F1F1")
#let rule-gray = rgb("#D9D9D9")

// Sizes (points). Body text stays at 36 pt or more so it reads from 2 m.
#let body-size = 36pt
#let small-size = 28pt
#let heading-size = 58pt
#let title-size = 110pt

// ---------------------------------------------------------------- page setup
#let poster(
  title: [Poster title],
  subtitle: none,
  tagline: none,
  course: none,
  team: (),
  advisor: none,
  sponsor: none,
  footer: none,
  body,
) = {
  set document(title: title)
  set page(
    width: 48in,
    height: 36in,
    margin: (x: 1.2in, top: 1in, bottom: 1in),
    footer: if footer != none {
      set text(size: small-size, fill: muted)
      line(length: 100%, stroke: 2pt + rule-gray)
      v(-0.1in)
      footer
    },
    footer-descent: 0.3in,
  )
  set text(font: ("Fira Sans", "Libertinus Serif"), size: body-size, fill: ink, lang: "en")
  set par(justify: false, leading: 0.55em, spacing: 0.9em)
  set list(indent: 0.2in, body-indent: 0.25in, spacing: 0.6em, marker: text(fill: olin-red)[•])
  set enum(indent: 0.2in, body-indent: 0.25in, spacing: 0.6em)
  show figure: set image(width: 100%)
  show strong: set text(weight: "semibold")
  show link: set text(fill: olin-red)

  // Tables: header row in red, light stripes, thin rules.
  set table(
    stroke: (x, y) => (bottom: 1.5pt + rule-gray),
    fill: (x, y) => if y == 0 { olin-red } else if calc.even(y) { tint },
    inset: (x: 0.2in, y: 0.15in),
    align: left + horizon,
  )
  show table.cell.where(y: 0): set text(fill: white, weight: "semibold")
  show table: set text(size: small-size + 2pt)

  // Figures: caption below, smaller and gray.
  show figure.caption: set text(size: small-size, fill: muted)
  set figure(gap: 0.25in)

  // ---- header
  grid(
    columns: (auto, 1fr, auto),
    column-gutter: 1in,
    align: (left + top, left + top, left + top),
    image("logos/WashU_Olin_Business_Stacked.png", height: 3in, alt: "WashU Olin Business School logo"),
    {
      if course != none {
        text(size: small-size, weight: "semibold", fill: olin-red, tracking: 0.08em, upper(course))
        v(0.15in)
      }
      block(text(size: title-size, weight: "bold", fill: ink, hyphenate: false, title))
      if subtitle != none {
        v(0.1in)
        text(size: heading-size - 8pt, fill: muted, subtitle)
      }
      if tagline != none {
        v(0.2in)
        text(size: heading-size - 10pt, weight: "semibold", fill: olin-green, tagline)
      }
    },
    {
      set text(size: small-size + 2pt)
      let label(s) = text(size: small-size - 2pt, weight: "semibold", fill: olin-red, tracking: 0.08em, upper(s))
      if team.len() > 0 {
        label[Team]
        v(-0.1in)
        team.join(linebreak())
        v(0.15in)
      }
      if advisor != none {
        label[Faculty advisor]
        v(-0.1in)
        advisor
        v(0.15in)
      }
      if sponsor != none {
        label[Sponsor]
        v(-0.1in)
        sponsor
      }
    },
  )
  v(0.35in)
  block(width: 100%, height: 0.18in, fill: olin-red)
  v(0.6in)
  body
}

// ---------------------------------------------------------------- building blocks

// Columns of the poster body. widths: e.g. (1fr, 1.4fr, 1fr).
#let columns-layout(widths: (1fr, 1fr, 1fr), ..cols) = grid(
  columns: widths,
  column-gutter: 1in,
  ..cols.pos(),
)

// A numbered section. Use: #section(1, [What problem?])[ body ]
#let section(num, title, body) = block(width: 100%, breakable: false, below: 0.8in)[
  #grid(
    columns: (auto, 1fr),
    column-gutter: 0.3in,
    align: horizon,
    box(fill: olin-red, inset: (x: 0.22in, y: 0.12in), radius: 4pt,
      text(size: heading-size - 6pt, weight: "bold", fill: white, str(num))),
    text(size: heading-size, weight: "bold", fill: ink, title),
  )
  #v(0.05in)
  #line(length: 100%, stroke: 2pt + rule-gray)
  #v(0.15in)
  #body
]

// A big number with a short label. Use: #stat([~90%], [of time goes to ...])
#let stat(value, label, note: none) = block(
  width: 100%, fill: tint, inset: 0.35in, radius: 6pt, breakable: false,
)[
  #grid(
    columns: (auto, 1fr),
    column-gutter: 0.4in,
    align: horizon,
    text(size: 90pt, weight: "bold", fill: olin-red, value),
    text(size: body-size, weight: "semibold", label),
  )
  #if note != none {
    v(0.1in)
    text(size: small-size, fill: muted, note)
  }
]

// A tinted box with an optional title.
#let callout(title: none, color: olin-green, body) = block(
  width: 100%, fill: color.lighten(90%), stroke: (left: 6pt + color),
  inset: 0.35in, radius: (right: 6pt), breakable: false,
)[
  #if title != none {
    text(weight: "bold", fill: color, title)
    v(0.05in)
  }
  #body
]

// The closing message. Dark green box, white text.
#let takeaway(title: [Key takeaway], body) = block(
  width: 100%, fill: olin-green, inset: 0.45in, radius: 6pt, breakable: false,
)[
  #set text(fill: white)
  #text(size: heading-size - 6pt, weight: "bold", title)
  #v(0.1in)
  #body
]

// Process steps left to right. Use: #steps(([Title], [Short text]), ([Title], [Text]))
#let steps(..items) = {
  let xs = items.pos()
  let cells = ()
  for (i, it) in xs.enumerate() {
    let (head, desc) = it
    cells.push(grid.cell(fill: if calc.even(i) { olin-red } else { olin-green }, inset: 0.25in)[
      #set text(fill: white)
      #text(size: body-size, weight: "bold")[#(i + 1) #h(0.1in) #head] \
      #text(size: small-size, desc)
    ])
    if i < xs.len() - 1 {
      cells.push(grid.cell(align: center + horizon, text(size: 48pt, fill: muted)[→]))
    }
  }
  let widths = ()
  for i in range(xs.len()) {
    widths.push(1fr)
    if i < xs.len() - 1 { widths.push(auto) }
  }
  grid(columns: widths, column-gutter: 0.15in, ..cells)
}

// Cards side by side, each with a colored title bar.
// Use: #cards(([Title], [Body]), ([Title], [Body]))
#let cards(..items) = {
  let xs = items.pos()
  grid(
    columns: (1fr,) * xs.len(),
    column-gutter: 0.3in,
    ..xs.enumerate().map(((i, it)) => {
      let (head, content) = it
      let c = if calc.even(i) { olin-red } else { olin-green }
      block(width: 100%, stroke: 2pt + c, radius: 6pt, clip: true)[
        #block(width: 100%, fill: c, inset: 0.2in, below: 0pt,
          text(fill: white, weight: "bold", head))
        #block(width: 100%, inset: 0.25in, text(size: small-size + 2pt, content))
      ]
    }),
  )
}
